# Application Settings
EXPMS_SECRET_KEY=dev-secret-change-in-production-please
EXPMS_APP_NAME=Expense & Payment Management System
EXPMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# For local SQLite: sqlite:///../data/expms.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
EXPMS_DATABASE_URL=sqlite:///../data/expms.db

# Storage Configuration
# Set EXPMS_STORAGE_TYPE to 'local' or 'r2' (Cloudflare R2)
EXPMS_STORAGE_TYPE=r2

# Local Storage (used when EXPMS_STORAGE_TYPE=local)
EXPMS_UPLOAD_DIR=../data/uploads
EXPMS_MAX_UPLOAD_SIZE_MB=15

# Cloudflare R2 Storage (used when EXPMS_STORAGE_TYPE=r2)
# Setup: Cloudflare dashboard -> R2 -> create a bucket -> Manage R2 API Tokens
# -> create an API token with Object Read & Write, scoped to that bucket.
# The Account ID is shown on the R2 overview page (also in the API token's
# generated endpoint URL).
EXPMS_R2_ACCOUNT_ID=your-cloudflare-account-id
EXPMS_R2_ACCESS_KEY_ID=your-r2-access-key-id
EXPMS_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
EXPMS_R2_BUCKET_NAME=your-bucket-name
# Optional: override the endpoint instead of deriving it from the account id.
# EXPMS_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Root "folder" (key prefix) all uploads are stored under in the bucket.
EXPMS_R2_PREFIX=SUNLEASE

# Document folder structure - each type of attachment is stored under its
# own top-level folder: <folder>/<project-code>/<YYYY>/<MM>/W<week>/<uuid4>.<ext>,
# either in EXPMS_UPLOAD_DIR (local) or under EXPMS_R2_PREFIX (R2). Rename any
# of these to relocate that category - existing files already saved are
# unaffected, only new uploads use the new name.
EXPMS_DOCUMENT_FOLDER_EXPENSE=expenses
EXPMS_DOCUMENT_FOLDER_INVOICE=invoices
EXPMS_DOCUMENT_FOLDER_PAYMENT=payments
# Used for both the overall claim attachment and per-line proof uploads.
EXPMS_DOCUMENT_FOLDER_CLAIM=employee-claims

# File Upload Restrictions
EXPMS_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp,.xlsx,.csv
EXPMS_ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# JWT Token Settings
EXPMS_ALGORITHM=HS256
EXPMS_ACCESS_TOKEN_EXPIRE_MINUTES=720
