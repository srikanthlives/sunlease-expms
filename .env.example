# Application Settings
EXPMS_SECRET_KEY=dev-secret-change-in-production-please
EXPMS_APP_NAME=Expense & Payment Management System
EXPMS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
# For local SQLite: sqlite:///../data/expms.db
# For PostgreSQL: postgresql://user:password@localhost/dbname
EXPMS_DATABASE_URL=sqlite:///../data/expms.db

# Storage Configuration
# Set EXPMS_STORAGE_TYPE to 'local' or 'gdrive' (Google Drive)
EXPMS_STORAGE_TYPE=gdrive

# Local Storage (used when EXPMS_STORAGE_TYPE=local)
EXPMS_UPLOAD_DIR=../data/uploads
EXPMS_MAX_UPLOAD_SIZE_MB=15

# Google Drive Storage (used when EXPMS_STORAGE_TYPE=gdrive)
# Setup Guide: See DEPLOYMENT.md
# 1. Create a Google Cloud project and enable Google Drive API
# 2. Create a service account and download JSON key
# 3. Share a Google Drive folder with the service account email
# 4. Set the folder ID below
EXPMS_GDRIVE_FOLDER_ID=your-google-drive-folder-id
# Path to Google Drive service account JSON key file (relative or absolute)
EXPMS_GDRIVE_CREDENTIALS_PATH=./gdrive-credentials.json
# Fallback used only if the file above isn't present: paste the entire
# service-account JSON key here instead (useful when you can't mount a
# file, e.g. some hosting platforms).
#
# Two ways to do this:
#
# 1. Single line (simplest - just paste the JSON as downloaded, unmodified):
# EXPMS_GDRIVE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
#
# 2. Spread across multiple lines: wrap the value in double quotes, escape
#    every double quote inside it as \", AND escape every backslash as \\
#    (this second escaping is required because Docker Compose's .env parser
#    turns \n into a real newline inside a quoted value, which is only
#    correct if you actually meant a literal newline - the private_key
#    field needs the two-character escape \n preserved as-is, so writing
#    \\n here is what survives the .env parser as \n by the time it reaches
#    the app, which is what JSON needs):
# EXPMS_GDRIVE_CREDENTIALS_JSON="{
#   \"type\": \"service_account\",
#   \"project_id\": \"...\",
#   \"private_key\": \"-----BEGIN PRIVATE KEY-----\\nMIIExampleKeyData\\n-----END PRIVATE KEY-----\\n\",
#   ...
# }"
#
# If in doubt, use option 1 - it's less error-prone.

# File Upload Restrictions
EXPMS_ALLOWED_UPLOAD_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.webp,.xlsx,.csv
EXPMS_ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# JWT Token Settings
EXPMS_ALGORITHM=HS256
EXPMS_ACCESS_TOKEN_EXPIRE_MINUTES=720
